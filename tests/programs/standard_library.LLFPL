-- The standard library, found relative to the interpreter binary.
Require(stdlib.LLFPL)

Commit(Square(5))
Commit(Cube(3))
Commit(AbsoluteValue(-42))
Commit(Negate(7))
Commit(SignOf(-3))
Commit(SignOf(0))
Commit(SignOf(3))
Commit(Minimum(10, 20))
Commit(Maximum(10, 20))
Commit(ClampToRange(250, 0, 100))
Commit(ClampToRange(-250, 0, 100))
Commit(Interpolate(0, 10, 0.25))
Commit(Interpolate(0, 10, 1))
Commit(Truncate(-7.75))
Commit(Truncate(7.75))
Commit(FractionalPart(7.25))
Commit(Reciprocal(4))
Commit(NearlyEqual(1, 1.0000001, 0.001))
Commit(ToDegrees(PI))
Commit(StoreScratch(16, 999))
Commit(LoadScratch(16))
Commit(PI)
Commit(E)
